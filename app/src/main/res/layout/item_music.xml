<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="16dp" android:paddingTop="7dp" android:paddingEnd="4dp" android:paddingBottom="7dp">

    <FrameLayout android:layout_width="54dp" android:layout_height="54dp">
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/cover" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:src="@drawable/cover_placeholder"
            app:shapeAppearanceOverlay="@style/Round12" />
        <TextView
            android:id="@+id/badge" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/badge_bg" android:gravity="center" android:textColor="#FFFFFF"
            android:textSize="22sp" android:textStyle="bold" android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp"
        android:layout_weight="1" android:orientation="vertical">
        <TextView
            android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="1" android:textColor="@color/music_text" android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="1dp" android:ellipsize="end" android:maxLines="1"
            android:textColor="@color/music_text_dim" android:textSize="13sp" />
        <TextView
            android:id="@+id/tags" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="1dp" android:ellipsize="end" android:maxLines="1"
            android:textColor="@color/music_accent" android:textSize="12sp" android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/heart" android:layout_width="42dp" android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Нравится"
        android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/ic_heart" android:tint="@color/music_text_dim" />
    <ImageButton
        android:id="@+id/menu" android:layout_width="42dp" android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Ещё"
        android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/ic_more" android:tint="@color/music_text_dim" />
</LinearLayout>
